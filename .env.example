# --- Gmail ---
# Download an OAuth "Desktop app" client JSON from Google Cloud Console and
# save it as credentials.json in the project root. No .env vars needed.
# Which inbox tab to sync: primary | promotions | social | updates | forums | all
# GMAIL_CATEGORY=primary
# How many of the latest matching emails to pull per sync (read or unread)
# GMAIL_MAX_RESULTS=100
# Optional: only sync email received within the last N days (default 0 = no limit)
# GMAIL_MAX_AGE_DAYS=30
# Optional extra Gmail search filter applied on top:
# GMAIL_QUERY=is:unread

# --- Local Models ---
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:3b-instruct
EMBEDDING_MODEL=all-MiniLM-L6-v2
WHISPER_MODEL=base.en
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=int8

# --- Storage (defaults are fine) ---
# DB_PATH=data/raw_cache.db
# CHROMA_PATH=data/chroma_db
